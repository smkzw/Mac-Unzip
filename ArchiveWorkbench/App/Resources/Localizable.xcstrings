        }
      }
    },
    "使用 UTF-8 文件名，自动排除 macOS 元数据；创建前检查 Windows 保留名、非法字符和名称冲突。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses UTF-8 filenames and excludes macOS metadata. Windows reserved names, invalid characters, and name conflicts are checked before creation."
          }
        }
      }
    },
